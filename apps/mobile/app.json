{
  "expo": {
    "name": "familog",
    "slug": "familog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "familog",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F8F5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gorieng.familog",
      "infoPlist": {
        "CFBundleDisplayName": "familog",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gorieng.familog",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F9F8F5"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "가족 기록에 사진을 붙이려고 사진첩을 열어요. 고른 사진만 우리 가족에게 보여요.",
          "cameraPermission": "가족 기록에 넣을 사진을 바로 찍으려고 카메라를 써요.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
