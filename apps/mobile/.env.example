# 이 파일을 복사해 `.env`로 만들고 값을 채운다. (.env는 git에 올라가지 않는다)
# 값 찾는 곳: https://supabase.com/dashboard/project/_?showConnect=true

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 새 프로젝트는 anon 대신 Publishable 키를 준다. 그 경우 위 대신 이쪽에 넣는다.
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# ⚠️ Secret / service_role 키는 RLS를 우회하므로 앱에 절대 넣지 말 것.
# 자세한 배경은 CLAUDE.md §12 "Supabase 스프린트" 참조.
