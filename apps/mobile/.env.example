# Supabase 연결 정보
#
# 이 파일을 복사해 `.env`로 만들고 실제 값을 채운다. (.env는 git에 올라가지 않는다)
#
# 값 찾는 곳
#   Connect 창 (URL·키를 한 번에)  https://supabase.com/dashboard/project/_?showConnect=true
#   키만 따로                      https://supabase.com/dashboard/project/_/settings/api-keys
#   ※ 링크의 `_`는 Supabase가 내 프로젝트로 알아서 보내준다
#
# Project URL은 언제나 https://<프로젝트 ref>.supabase.co 형태다.
# ref는 대시보드 주소창에서 보인다 → supabase.com/dashboard/project/<ref>

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# ⚠️ Publishable 키를 쓴다 (sb_publishable_ 로 시작하는 짧은 문자열).
#
#    Supabase는 기존 anon / service_role 키를 2026년 말까지 폐지한다.
#    `eyJ...`로 시작하는 긴 JWT를 안내하는 글은 옛 방식이다.
#
#    Publishable = 앱에 담겨 배포되는 키. 노출돼도 RLS가 막아준다.
#    Secret(sb_secret_...) = RLS를 우회한다. 앱에 절대 넣지 말 것.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# 옛 프로젝트에서 아직 anon 키를 쓰고 있다면 이쪽에 넣어도 동작한다 (위가 우선).
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
